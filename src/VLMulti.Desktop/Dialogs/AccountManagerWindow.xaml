<Window x:Class="VLMulti.Desktop.Dialogs.AccountManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý acc" Icon="/vl.ico" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextMain}">
    <StackPanel Margin="16">
        <Grid x:Name="Rows">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Text="Khung" Foreground="{StaticResource TextDim}" Margin="0,0,10,6" />
            <TextBlock Grid.Column="1" Text="Nhân vật" Foreground="{StaticResource TextDim}" Margin="0,0,10,6" />
            <TextBlock Grid.Column="2" Text="Tài khoản" Foreground="{StaticResource TextDim}" Margin="0,0,10,6" />
            <TextBlock Grid.Column="3" Text="Mật khẩu" Foreground="{StaticResource TextDim}" Margin="0,0,10,6" />
            <TextBlock Grid.Column="4" Text="Tự đăng nhập" Foreground="{StaticResource TextDim}" Margin="0,0,10,6" />
        </Grid>
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" MaxWidth="700" Foreground="{StaticResource TextDim}"
                   Text="Mật khẩu được mã hoá bằng Windows và chỉ dùng được trên máy này, với tài khoản Windows này. Để trống ô mật khẩu = giữ mật khẩu đã lưu." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource BarButton}" Content="Lưu" MinWidth="80" IsDefault="True" Click="Save_Click" />
            <Button Style="{StaticResource BarButton}" Content="Huỷ" MinWidth="80" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
