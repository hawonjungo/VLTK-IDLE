<Application x:Class="VLMulti.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Cùng bảng màu với trang web điện thoại (wwwroot/app.css) -->
        <SolidColorBrush x:Key="WindowBg" Color="#121314" />
        <SolidColorBrush x:Key="BarBg" Color="#18191B" />
        <SolidColorBrush x:Key="HeaderBg" Color="#1C1E20" />
        <SolidColorBrush x:Key="CardBg" Color="#1C1E20" />
        <SolidColorBrush x:Key="Card2Bg" Color="#24272A" />
        <SolidColorBrush x:Key="FrameBorder" Color="#2E3135" />
        <SolidColorBrush x:Key="Accent" Color="#2F81F7" />
        <SolidColorBrush x:Key="OnBg" Color="#2EA043" />
        <SolidColorBrush x:Key="OkFg" Color="#3FB950" />
        <SolidColorBrush x:Key="WarnFg" Color="#D29922" />
        <SolidColorBrush x:Key="ErrorFg" Color="#F85149" />
        <SolidColorBrush x:Key="GoldFg" Color="#E3B341" />
        <SolidColorBrush x:Key="TextMain" Color="#E8E6E3" />
        <SolidColorBrush x:Key="TextDim" Color="#9AA0A6" />
        <SolidColorBrush x:Key="TextFaint" Color="#6E7681" />
        <!-- Biểu tượng nét mảnh có sẵn trong Windows 10/11 (không dùng emoji vì mỗi máy hiện một kiểu) -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#24272A" />
            <Setter Property="Foreground" Value="#E8E6E3" />
            <Setter Property="BorderBrush" Value="#3A3E43" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="Background" Value="{StaticResource Card2Bg}" />
            <Setter Property="BorderBrush" Value="#34383D" />
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A4F55" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Nút chỉ có biểu tượng (đặt Content là mã ký tự của IconFont) -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        </Style>

        <!-- Công tắc dạng nhãn nhỏ trên thanh khung game ("Tự động", "Kéo quái"); bật = nền xanh -->
        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        </Style>

        <!-- Thẻ của cột bên phải (Tổng quan · Nhật ký · Cài đặt) -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="4,8">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource TextMain}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextMain}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút lọc trong Nhật ký -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,5,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource Card2Bg}" BorderBrush="#34383D" BorderThickness="1"
                                CornerRadius="11" Padding="9,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Card2Bg}" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="BorderBrush" Value="#34383D" />
            <Setter Property="CaretBrush" Value="{StaticResource TextMain}" />
            <Setter Property="Padding" Value="5,3" />
        </Style>
    </Application.Resources>
</Application>
